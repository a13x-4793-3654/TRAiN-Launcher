{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRAiN Launcher",
  "version": "0.1.0",
  "identifier": "com.train.launcher",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend"
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TRAiN Launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMTQ2NkI3M0Q5RjNGNkIKUldSclA1ODl0MllVWWhHb3JTaURzY1pFdEwzUFJhZGFrejVKSjNFWFlCOGF5Wmg4eEJpSm5FZ0oK",
      "endpoints": [
        "https://github.com/a13x-4793-3654/TRAiN-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
